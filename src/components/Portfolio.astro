---
import { DATA, WEB_ENABLED, type ModeKey, type Project } from '../data/portfolio';

interface Props {
  mode: ModeKey;
}

const { mode } = Astro.props;
const d = DATA[mode];
const pad = (n: number) => String(n).padStart(2, '0');
const CV = '/assets/FernandoCortes_CV.pdf';
const MAIL = 'ferdevcortes@gmail.com';

const SOCIALS = [
  { label: 'github', href: 'https://github.com/TaCodeC' },
  { label: 'linkedin', href: 'https://linkedin.com/in/fernandocortesdev' },
  { label: 'instagram', href: 'https://www.instagram.com/fdanmc/' },
];

const GUN = [
  '.##############.',
  '################',
  '################',
  '........#..#####',
  '.........##.####',
  '...........#####',
  '...........####.',
  '..........#####.',
]
  .join('')
  .split('')
  .map((c) => c === '#');

// "Herrería Embrujada" -> "herreria-embrujada": the card id and its shareable #hash.
const slug = (t: string) =>
  t
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const cardInfo = (p: Project) => {
  const media = p.media ?? [];
  const embed = !!p.yt || !!p.ig;
  const isVideo = embed || media[0]?.type === 'video' || media[0]?.type === 'youtube';
  const isGallery = !isVideo && media.length > 1;
  // Breakdown media follows the embed, so it starts at slide 1.
  const breakdown = embed && media.length > 0;
  const slides = (embed ? 1 : 0) + media.length;
  return {
    pid: slug(p.title),
    thumb: p.img ?? `https://i.ytimg.com/vi/${p.yt}/maxresdefault.jpg`,
    fallback: p.yt && !p.img ? `https://i.ytimg.com/vi/${p.yt}/hqdefault.jpg` : undefined,
    badge: p.turntable ? '↻ 360°' : isVideo ? (slides > 1 && !breakdown ? `▶ play · ${slides}` : '▶ play') : isGallery ? `view · ${media.length}` : 'view',
    breakdown,
    action: p.turntable ? `Spin ${p.title}` : isVideo ? `Play ${p.title}` : isGallery ? `View ${p.title}, ${media.length} images` : `View ${p.title}`,
  };
};

const sections = d.sections.map((s, i) => ({
  ...s,
  n: pad(i + 1),
  // Nav label: "shaders & rendering" -> "shaders".
  short: s.title.split(' & ')[0],
  projects: (s.projects ?? []).map((p) => ({ ...p, ...cardInfo(p) })),
}));

// Modal payload, keyed by card id.
const payload = Object.fromEntries(
  sections.flatMap((s) =>
    s.projects.map((p) => [p.pid, { title: p.title, desc: p.desc, tags: p.tags, links: p.links, yt: p.yt, ig: p.ig, media: p.media, turntable: p.turntable }]),
  ),
);
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<a class="skip" href="#work">skip to work</a>

<canvas class="grid-bg" data-grid aria-hidden="true"></canvas>

<div class="fc" id="top" data-fc data-hue={d.hue}>
  <aside class="profile" aria-label="Profile">
    <div class="profile-top">
      <span>~/fernando</span>
      <button class="btn btn-tertiary btn-xs" type="button" data-theme-toggle>theme: <span data-theme-label>dark</span></button>
    </div>

    <div class="intro">
      <div class="photo">
        <img src="/media/fernando-cortes.jpg" alt="Fernando Daniel Martínez Cortés" width="809" height="613" />
      </div>
      <div class="who">
        <h1>Fernando Daniel Martínez Cortés</h1>
        <p class="meta">Guanajuato, MX · UTC-6</p>
        <p class="status">open to remote</p>
      </div>
    </div>

    <p class="bio">{d.bio}</p>

    <div class="cta">
      <a class="btn btn-primary btn-lg" href={CV} download="FernandoCortes_CV.pdf">↓ download CV</a>
      <a class="btn btn-secondary btn-lg" href={`mailto:${MAIL}`}>{MAIL}</a>
    </div>

    <ul class="socials" aria-label="Social links">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noreferrer">
              {s.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="block">
      <h2 class="label">// stack</h2>
      <ul class="tags tags-stack">
        {d.stack.map((t) => <li class="tag">{t}</li>)}
      </ul>
    </div>
  </aside>

  <main class="main" id="work">
    {
      WEB_ENABLED && (
        <nav class="modes" aria-label="Portfolio mode">
          <a href="/" class:list={[{ active: mode === 'unity' }]} aria-current={mode === 'unity' ? 'page' : undefined}>/unity-techart</a>
          <a href="/WebDeveloping/" class:list={[{ active: mode === 'web' }]} aria-current={mode === 'web' ? 'page' : undefined}>/WebDeveloping</a>
        </nav>
      )
    }

    <header class="hero">
      <p class="prompt">$ cd ~/work/{d.slug} &amp;&amp; ls</p>
      <p class="hero-title">
        <span class="title-a">{d.titleA}</span>
        <span class="title-sep" aria-hidden="true">|</span>
        <span class="title-b">{d.titleB}</span>
      </p>
      <p class="headline">{d.headline}</p>
    </header>

    <nav class="jump" aria-label="Sections">
      <div class="jump-track" data-jump>
        {sections.map((s) => <a href={`#${s.id}`}>{s.short}</a>)}
        <a href="#about">about</a>
      </div>
    </nav>

    {
      sections.map((s) => (
        <section id={s.id} class="section" aria-labelledby={`${s.id}-title`}>
          <div class="section-head">
            <span class="sec-n" aria-hidden="true">{s.n}/</span>
            <h2 id={`${s.id}-title`}>{s.title}</h2>
            <p class="section-note">{s.note}</p>
          </div>
          {s.projects.length ? (
            <div class="grid">
              {s.projects.map((p) => (
                <article class="card" id={p.pid} data-card data-pid={p.pid}>
                  <button class="card-thumb" type="button" data-card-open aria-label={p.action}>
                    <img
                      src={p.thumb}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      data-fallback={p.fallback}
                      onload={p.fallback ? "if(this.naturalWidth<=120&&this.dataset.fallback){this.src=this.dataset.fallback;delete this.dataset.fallback}" : undefined}
                      onerror={p.fallback ? "if(this.dataset.fallback){this.src=this.dataset.fallback;delete this.dataset.fallback}" : undefined}
                    />
                    {p.preview && <video class="card-preview" src={p.preview} muted loop playsinline preload="none" aria-hidden="true" data-preview />}
                    <span class="badge" aria-hidden="true">{p.badge}</span>
                    {p.breakdown && <span class="badge badge-extra" aria-hidden="true">+ breakdown</span>}
                  </button>
                  <div class="card-body">
                    <h3 class="card-title">{p.title}</h3>
                    <p class="card-desc">{p.desc}</p>
                    {(p.links || p.breakdown) && (
                      <div class="card-links">
                        {p.breakdown && (
                          <button class="btn btn-secondary" type="button" data-open-at="1" aria-label={`Open the ${p.title} breakdown`}>
                            breakdown ›
                          </button>
                        )}
                        {p.links?.map((l) => (
                          <a class="btn btn-secondary" href={l.href} target="_blank" rel="noreferrer">
                            {l.label} <span aria-hidden="true">↗</span>
                          </a>
                        ))}
                      </div>
                    )}
                    <ul class="tags">
                      {p.tags.map((t) => (
                        <li class="tag">{t}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty">// work in progress</p>
          )}
        </section>
      ))
    }

    <section id="about" class="section" aria-labelledby="about-title">
      <div class="section-head">
        <span class="sec-n" aria-hidden="true">~/</span>
        <h2 id="about-title">about</h2>
      </div>
      <div class="about">
        <div data-exp>
          <div class="exp-head">
            <h3 class="label">// experience</h3>
            <button class="btn btn-tertiary btn-xs" type="button" data-exp-toggle aria-expanded="false" aria-controls="exp-list">
              <span data-exp-label>show details</span>
            </button>
          </div>
          <ol class="exp-list" id="exp-list">
            {
              d.exp.map((e) => (
                <li class="exp">
                  <span class="exp-role">{e.role}</span>
                  <span class="exp-org">{e.org}</span>
                  <span class="exp-date">{e.date}</span>
                  <ul class="exp-info">
                    {e.info.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="block">
          <h3 class="label">// education</h3>
          <p class="edu">B.A. Digital Arts · Universidad de Guanajuato</p>
          <p class="meta">Expected Dec 2026 · GPA 9.4/10</p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>© 2026 Fernando Cortés</span>
      <a href={`mailto:${MAIL}`}>{MAIL}</a>
      <a href="#top">↑ top</a>
    </footer>
  </main>
</div>

<div class="modal" data-modal data-noshoot hidden>
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-head">
      <h2 class="modal-title" id="modal-title"><span aria-hidden="true">&gt; </span><span data-modal-title></span></h2>
      <div class="modal-actions">
        <a class="btn btn-tertiary" data-modal-ext target="_blank" rel="noreferrer">youtube ↗</a>
        <button class="btn btn-tertiary" type="button" data-modal-close>close<span class="kbd-hint"> · esc</span></button>
      </div>
    </div>
    <div class="modal-stage" data-modal-stage></div>
    <div class="modal-nav" data-modal-nav hidden>
      <button class="btn btn-tertiary" type="button" data-modal-prev aria-label="Previous">‹ prev</button>
      <span class="modal-caption" data-modal-caption></span>
      <div class="modal-chips" data-modal-chips></div>
      <span data-modal-count></span>
      <button class="btn btn-tertiary" type="button" data-modal-next aria-label="Next">next ›</button>
    </div>
    <div class="modal-info">
      <p class="modal-desc" data-modal-desc></p>
      <div class="card-links" data-modal-links></div>
      <ul class="tags" data-modal-tags></ul>
    </div>
  </div>
</div>

<div class="fx" data-fx data-noshoot></div>
<div class="gun-widget" data-gun-widget data-noshoot>
  <div class="gun" data-gun title="Pick up the gun" aria-hidden="true">
    {GUN.map((on) => <span class:list={[{ on }]} />)}
    <div class="gun-flash" data-gun-flash></div>
    <span class="gun-label" data-gun-label>Try it!</span>
  </div>
  <div class="gun-ctrls" data-gun-ctrls hidden>
    <button class="btn btn-primary" type="button" data-gun-reload>↺ reload</button>
    <button class="btn btn-tertiary" type="button" data-gun-exit>exit · esc</button>
  </div>
</div>

<script type="application/json" id="fc-projects" set:html={payloadJson} />

<script>
  import '../scripts/portfolio';
</script>
